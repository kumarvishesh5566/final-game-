# ==========================================
# Skribbl.io Multiplayer Environment Config
# ==========================================

# 1. Server Port (Railway and Render automatically supply this)
PORT=3000

# 2. Runtime Environment ('development' or 'production')
NODE_ENV=production

# 3. Optional: MongoDB Atlas Connection URI
# Leave blank to run in fast in-memory mode without cloud persistence.
# Fill in to enable persistent all-time Hall of Fame leaderboards & match logs.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/activityservice_db?retryWrites=true&w=majority"

# 4. Frontend-to-Backend URL (Used ONLY when deploying frontend separately on Vercel)
# If deploying all-in-one on Railway or Render, leave this blank (defaults to same origin).
# If frontend is hosted on Vercel, set this to your Railway/Render backend URL:
# Example: VITE_BACKEND_URL="https://your-backend.railway.app" or "https://your-backend.onrender.com"
VITE_BACKEND_URL=""
